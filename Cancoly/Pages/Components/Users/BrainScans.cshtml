@page "/user-brain-scans"
@model Cancoly.Pages.Components.Users.BrainScansModel
@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Brain Scan Management";
    
    var max = 5;
    if (User.IsInRole("Professional")) max = 50;
    if (User.IsInRole("Business")) max = 100;
}

<div class="container-fluid py-4 px-md-5 bg-light min-vh-100">
    <!-- Sophisticated Header -->
    <div class="card border-0 shadow-sm mb-5 overflow-hidden position-relative" style="background: #151b94;">
        <div class="card-body p-4 p-md-3
position-relative z-index-1">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <nav aria-label="breadcrumb" class="mb-3">
                        <ol class="breadcrumb breadcrumb-light mb-0">
                            <li class="breadcrumb-item"><a href="/dashboard" class="text-white opacity-75 text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item text-white active" aria-current="page">Brain Scans</li>
                        </ol>
                    </nav>
                    <h2 class="display-6 fw-bold text-white mb-2">Patient Scan Repository</h2>
                    <p class="text-white opacity-75 mb-0 fs-5">Manage, analyze, and store clinical MRI data with AI-powered insights.</p>
                </div>
                <div class="col-lg-4 d-none d-lg-block text-end">
                    <img src="assets/img/brain.png" class="img-fluid" style="max-height: 180px; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));" alt="Brain Visualization">
                </div>
            </div>
        </div>

    </div>

    <!-- Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0">Recent Scans</h4>
        <button type="button" class="btn btn-primary shadow-sm px-4 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class="bx bx-plus-circle me-2"></i> New Diagnostic Scan
        </button>
    </div>

    <!-- Scans Grid -->
    <div class="row g-4">
        @if(Model.brainScans != null && Model.brainScans.Any())
        {
            @foreach (var data in Model.brainScans)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 transition-hover overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                                    <i class="bx bx-scan text-primary fs-3"></i>
                                </div>
                                <div class="ms-auto">
                                    <span class="badge bg-light text-muted border">ID: @data.Id.ToString().Substring(0, 5)</span>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">@data.Title</h5>
                            <p class="text-muted small mb-4">Clinical MRI Analysis</p>
                            
                            <div class="d-grid">
                                <a href="/user-scan-report?id=@data.Id" class="btn btn-outline-primary border-2 fw-bold">
                                    View Report <i class="bx bx-right-arrow-alt ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white p-5 rounded-4 shadow-sm">
                    <i class="bx bx-folder-open text-muted display-1 mb-3"></i>
                    <h4 class="text-muted">No scans found</h4>
                    <p class="text-muted mb-4">Start by uploading your first patient brain scan.</p>
                    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#uploadModal">Upload Now</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" enctype="multipart/form-data" class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light p-4">
                <h5 class="modal-title fw-bold" id="uploadModalLabel">
                    <i class="bx bx-cloud-upload me-2 text-primary"></i> Upload Diagnostic Scan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input name="type" value="create" hidden />
                
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-uppercase text-muted">Patient Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bx bx-user text-muted"></i></span>
                            <input name="title" required type="text" class="form-control border-start-0 ps-0" placeholder="e.g. John Doe">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-uppercase text-muted">Patient Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bx bx-envelope text-muted"></i></span>
                            <input name="email" required type="email" class="form-control border-start-0 ps-0" placeholder="patient@example.com">
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-uppercase text-muted">Imaging Modality</label>
                        <select name="file_type" required class="form-select">
                            <option value="" selected disabled>Choose modality...</option>
                            <option value="dcm">DICOM (Standard Medical)</option>
                            <option value="image">Standard Image (PNG/JPG)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-uppercase text-muted">File Selection <span class="text-primary">(Max @max)</span></label>
                        <input type="file" name="test" id="fileInput" accept=".jpg,.png,.jpeg,.dcm,application/dicom" multiple class="form-control">
                    </div>
                </div>

                <div class="alert alert-warning border-0 bg-warning bg-opacity-10 p-3 mb-4 rounded-3">
                    <div class="d-flex">
                        <i class="bx bx-error-circle fs-4 me-3 text-warning"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Clinical Integrity Warning</h6>
                            <p class="small text-dark mb-0 opacity-75">
                                Only upload authentic Brain MRI scans. Non-clinical imagery degrades AI accuracy and may lead to account suspension.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Preview Area -->
                <div class="row g-2" id="fileDisplayArea">
                    <!-- Previews injected here -->
                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-0">
                <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Process & Save Scan</button>
            </div>
        </form>
    </div>
</div>

<style>
    .transition-hover { transition: all 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; }
    .breadcrumb-light .breadcrumb-item + .breadcrumb-item::before { color: rgba(255,255,255,0.5); }
    .ls-wide { letter-spacing: 0.05em; }
    .preview-card { position: relative; border-radius: 12px; overflow: hidden; border: 2px solid #f1f5f9; }
    .preview-card img { width: 100%; height: 120px; object-fit: cover; }
    .preview-card .file-name { font-size: 10px; padding: 5px; background: rgba(255,255,255,0.9); position: absolute; bottom: 0; width: 100%; text-align: center; }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const fileInput = document.getElementById('fileInput');
            const fileDisplayArea = document.getElementById('fileDisplayArea');

            fileInput.addEventListener('change', () => {
                fileDisplayArea.innerHTML = '';
                const files = Array.from(fileInput.files);

                if (files.length > @(max)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Limit Exceeded',
                        text: `Your current plan allows up to @(max) files per upload.`
                    });
                    fileInput.value = '';
                    return;
                }

                files.forEach(file => {
                    const col = document.createElement('div');
                    col.className = 'col-3 col-md-2 mb-3';
                    
                    const card = document.createElement('div');
                    card.className = 'preview-card shadow-sm';

                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = (e) => {
                            card.innerHTML = `
                                <img src="${e.target.result}" alt="Preview">
                                <div class="file-name text-truncate">${file.name}</div>
                            `;
                        };
                        reader.readAsDataURL(file);
                    } else {
                        card.innerHTML = `
                            <div class="d-flex flex-column align-items-center justify-content-center bg-light" style="height: 120px;">
                                <i class="bx bxs-file-doc fs-1 text-primary"></i>
                            </div>
                            <div class="file-name text-truncate">${file.name}</div>
                        `;
                    }
                    
                    col.appendChild(card);
                    fileDisplayArea.appendChild(col);
                });
            });
        });
    </script>
}
